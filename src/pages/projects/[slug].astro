---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// Generate static paths for all projects
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

// Get the project data from the collection
const { project } = Astro.props;
const { Content } = await render(project);

// Extract project data
const { title, description, image, technologies, demoUrl, repoUrl, publishDate } = project.data;

// Format the date
const formattedDate = new Date(publishDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout>
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <a href="/#projects" class="text-primary hover:text-(--color-primary-dark)">
        ← Back to Projects
      </a>
    </div>

    <article class="prose prose-lg dark:prose-invert max-w-none">
      {image && (
        <div class="mb-8 overflow-hidden h-162.5 rounded-lg border-[0.1rem] border-accent/20">
          <img src={image} alt={title} class="h-full w-full object-cover object-top mt-0" />
        </div>
      )}

      <header class="mb-8">
        <h1 class="text-4xl font-bold text-primary">{title}</h1>
        <p class="text-lg text-(--color-text-muted)">{description}</p>
        <div class="mt-4">
          <span class="text-sm text-(--color-text-muted)">Published on {formattedDate}</span>
        </div>
      </header>

      <div class="mb-8 flex flex-wrap gap-2">
        {technologies.map((tech) => (
          <span class="rounded-full bg-black/30 px-3 py-1 text-sm text-(--color-primary-dark)">
            {tech}
          </span>
        ))}
      </div>

      <div class="mb-8 flex gap-4">
        {demoUrl && (
          <a 
            href={demoUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-md border no-underline hover:text-white px-4 py-2 text-accent hover:bg-(--color-primary-dark)"
          >
            View Demo
          </a>
        )}
        {repoUrl && (
          <a 
            href={repoUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex no-underline items-center rounded-md border border-primary px-4 py-2 text-primary hover:bg-(--color-primary-light) hover:text-white"
          >
            View Code
          </a>
        )}
      </div>

      <div class="project-content">
        <Content />
      </div>
    </article>
  </div>
</Layout>