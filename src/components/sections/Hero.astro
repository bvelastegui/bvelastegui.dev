---
import { Image } from 'astro:assets'
import phpImage from '../../assets/php.svg'
import nodeImage from '../../assets/nodejs.svg'
import psqlImage from '../../assets/postgresql.svg'
import gitImage from '../../assets/git.svg'
import archImage from '../../assets/archlinux.svg'
import ownerImage from '../../assets/me.jpg'
---

<section
  id="hero"
  class="container mx-auto flex flex-col md:flex-row items-center justify-center py-16 md:pt-24 md:pb-36 px-4 md:px-12"
>
  <div
    class="relative shrink-0 flex items-center justify-center w-40 h-56 md:w-56 md:h-72 border-2 border-accent-blue mb-8 md:mb-0">
    <div class="absolute -right-2 -bottom-6 p-2 bg-secondary size-16"></div>
    <div
      class="text-6xl bg-linear-to-r text-shadow-accent-blue from-accent to-accent-blue bg-clip-text text-transparent font-black font-mono absolute z-20 -right-8 -bottom-7 tracking-tighter">
      {"</>"}
    </div>

    <Image
      src={ownerImage}
      class="max-h-full z-10"
      alt="Bryan Velastegui"
      loading="eager"
    />
  </div>
  <!-- Contenido principal -->
  <div class="flex flex-col items-center md:items-start text-center md:text-left md:ml-30">
    <h1 class="mb-4 text-5xl md:text-6xl font-bold text-white leading-snug">
      Hola, soy Bryan<span class="text-accent">.</span><br />
      <span class="bg-linear-to-r from-muted to-muted/30 bg-clip-text text-transparent">FullStack Dev</span>
    </h1>
    <p class="text-muted text-sm mb-6 max-w-sm">
      Más de 7 años construyendo sistemas web escalables. Especializado en PHP/Laravel, Vue.js y Docker.
    </p>
    <a
      href="#contact"
      class="border border-accent text-accent px-4 py-2 text-sm font-semibold hover:bg-accent hover:text-secondary transition-colors"
    >
      Contáctame
    </a>
  </div>
</section>
