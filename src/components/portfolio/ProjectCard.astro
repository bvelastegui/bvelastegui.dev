---
// ProjectCard.astro - Reusable project card component
import type { CollectionEntry } from "astro:content";

interface Props {
  project?: CollectionEntry<"projects">;
  slug: string;
  title: string;
  description: string;
  image?: string;
  technologies: string[];
}

const { slug, title, description, image, technologies } = Astro.props;
---

<div
  class="overflow-hidden relative rounded-lg border border-(--color-border) bg-(--color-background-alt) shadow-sm transition-shadow hover:shadow-md"
>
  <div class="flex flex-col h-full">
    <div
        class="flex mb-6 h-48 items-center justify-center bg-(--color-primary-light)"
    >
      {image ? (
          <img
              src={image}
              alt={title}
              class="h-full w-full object-cover"
          />
      ) : (
          <span class="bg-linear-to-br from-accent-blue to-accent h-full w-full grayscale group-hover:grayscale-0 group-hover:duration-150"></span>
      )}
    </div>
    <h3 class="px-6 mb-2 text-xl font-bold text-primary">
      {title}
    </h3>
    <p class="px-6 mb-4 text-muted">
      {description}
    </p>
    <div class="mt-auto px-6 mb-4 flex flex-wrap gap-2">
      {
        technologies.map((tech) => (
          <span class="rounded-full bg-black/30 px-2 py-1 text-xs text-accent-blue">
            {tech}
          </span>
        ))
      }
    </div>
    <a
      href={`/projects/${slug}`}
      class="mt-auto px-6 pt-6 mb-6 font-medium text-primary hover:text-(--color-primary-dark)"
    >
      View Project →
    </a>
  </div>
</div>
