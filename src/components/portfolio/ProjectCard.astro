---
// ProjectCard.astro - Reusable project card component

interface Props {
  slug: string;
  title: string;
  description: string;
  image?: string;
  technologies: string[];
}

const { slug, title, description, image, technologies } = Astro.props;
---

<div
  class="overflow-hidden relative border-2 border-accent-blue bg-(--color-background-alt) shadow-sm transition-shadow hover:shadow-md"
>
  <div class="flex flex-col h-full">
    <div
        class="flex mb-6 h-48 items-center justify-center bg-(--color-primary-light)"
    >
      {image ? (
          <img
              src={image}
              alt={title}
              class="h-full w-full object-cover"
          />
      ) : (
          <span class="bg-linear-to-br from-accent-blue to-accent h-full w-full grayscale group-hover:grayscale-0 group-hover:duration-150"></span>
      )}
    </div>
    <h3 class="px-6 mb-2 text-xl font-bold text-white">
      {title}
    </h3>
    <p class="px-6 mb-4 text-muted">
      {description}
    </p>
    <div class="mt-auto px-6 mb-4 flex flex-wrap gap-2">
      {
        technologies.map((tech) => (
          <span class="bg-black/30 px-2 py-1 text-xs text-white">
            {tech}
          </span>
        ))
      }
    </div>
    <a
      href={`/projects/${slug}`}
      class="mt-auto px-6 pt-6 mb-6 font-medium text-accent hover:text-white flex gap-1 items-center"
    >
      Ver Proyecto
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</div>
